# Base URL of the API. The browser calls it directly, so it is
# public (VITE_* is bundled into the client) — never put secrets here.
VITE_API_URL=http://localhost:3002

# Production (Vercel project settings, not this file):
#   VITE_API_URL — leave unset: a production build calls /api on its own
#                  domain and vercel.json forwards it to the API.
#   VITE_WS_URL=wss://auto-lincoln-api.onrender.com
